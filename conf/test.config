/*
    Test profile — single tile, chr20 smoke run.
    run_dir is the public Cytos 3' demo run; the chr20 smoke genome (FASTA, STAR
    index, GENCODE GTF) comes from the default reference bucket. Supply the eight
    container params at launch.
*/
params {
    config_profile_name = 'Test profile'

    run_dir       = "s3://element-public-data/Cytos/runs/Cytos-3Prime_HeLa-Tunicamycin/"
    id            = "Cytos-3Prime_HeLa-Tunicamycin"
    outdir        = "./results/"
    tile          = ["L1R01C01S1"]           // 1 tile

    genome        = "GRCh38_chr20"
}

// Resources for the smoke run. One tile against chr20 needs a fraction of a
// full run, so the generic label tiers in conf/base.config (process_high asks
// 12 CPU / 72 GB) are far too large. resourceLimits is set directly rather
// than through params.max_*: conf/base.config is included before profiles{},
// so it binds the base defaults and a profile cannot change them afterwards.
// Retries do not scale up — the ceiling makes that pointless.
process {
    resourceLimits = [ cpus: 8, memory: 28.GB, time: 8.h ]

    cpus   = 1
    memory = 6.GB
    time   = 2.h

    withLabel:process_single { cpus = 1; memory = 1.GB; time = 1.h }
    withLabel:process_low    { cpus = 2; memory = 4.GB; time = 1.h }
    withLabel:process_medium { cpus = 4; memory = 8.GB; time = 2.h }
    withLabel:process_high   { cpus = 8; memory = 24.GB; time = 4.h }
}

// Smoke iGenomes (GRCh38_chr20) — included last so genome paths bind to igenomes_base.
includeConfig 'igenomes_smoke.config'
