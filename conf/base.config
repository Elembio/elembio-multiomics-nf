/*
========================================================================================
    elembio-multiomics-nf base config
========================================================================================
    Default resource allocations for all processes. Assumes containerized execution.
    Process-specific overrides are in conf/AVITI24.config (AVITI24) or conf/test.config.
----------------------------------------------------------------------------------------
*/

process {

    // Per-process caps (replaces legacy nf-core check_max helper).
    // Nextflow >=24.04 enforces these limits natively on every directive.
    resourceLimits = [
        cpus  : params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time  : params.max_time as nextflow.util.Duration,
    ]

    cpus   = { 1    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 4.h  * task.attempt }

    // Retry transient errors; terminate immediately on 127 (command not found)
    errorStrategy = { task.exitStatus in [127] ? 'finish' : 'retry' }

    maxRetries    = 5
    maxErrors     = '-1'

    // Process-specific resource requirements
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 1.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 4.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 4     * task.attempt }
        memory = { 8.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel:process_long {
        time   = { 8.h  * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    withName: 'BASES2FASTQ' {
        scratch = true
    }
    withName: 'CELLS2STATS' {
        scratch = true
    }
    withName: 'CELLS2STATS_SPATIALDATABUILD_VIZ' {
        scratch = true
    }
    withName: 'BUILD_SPATIALDATA' {
        scratch = true
    }
}

aws {
    batch {
        cliPath = '/home/ec2-user/miniconda/bin/aws'
        maxParallelTransfers = 16
        maxTransferAttempts  = 6
        forceGlacierTransfer = true
    }
    client {
        maxConnections = 16
        uploadMaxThreads = 16
        maxErrorRetry = 8
        uploadRetrySleep = 200
        uploadChunkSize = 32.MB
    }
}

docker {
    enabled = true
}
