/*
========================================================================================
    AVITI24 resource profile
========================================================================================
    Per-process CPU, memory, and time allocations for full AVITI24 runs.

    Use as follows:
        nextflow run . -profile AVITI24,docker   (AVITI is kept as an alias)

----------------------------------------------------------------------------------------
*/
params {
    config_profile_name        = 'AVITI24 profile'
    config_profile_description = 'AVITI24 resource profile'
}

process {
    withName: CELLS2STATS {
        cpus = {
            def cpu_ladder = [46, 24, 12]   // step threads down on retry; c2s peak RAM scales with -j
            task.attempt <= cpu_ladder.size() ? cpu_ladder[task.attempt - 1] : cpu_ladder.last()
        }
        memory = 180.GB                      // pinned at instance ceiling (== params.max_memory); the CPU ladder is the OOM lever
        time = { 8.h * task.attempt }        // fewer threads = slower; grant more wall-time each attempt
        maxRetries = 2
    }
    withName: CELLS2STATS_SPATIALDATABUILD_VIZ {
        cpus = 12
        memory = { 32.GB + (task.attempt - 1) * 16.GB }   // 32 → 48 → 64
        time = { 4.h * task.attempt }
        maxRetries = 2
    }
    withName: CELLS2STATS_GENERATE_QC_REPORT {
        cpus = 8
        memory = { 16.GB + (task.attempt - 1) * 8.GB }    // 16 → 24 → 32
        time = { 2.h * task.attempt }
        maxRetries = 2
    }
    withName: BASES2FASTQ {
        cpus = 32
        memory = 64.GB
        time = 1.h
        maxRetries = 2
    }
    withName: GTF_PREPROCESSING {
        cpus = 4
        memory = 32.GB
        time = 1.h
        maxRetries = 2
    }
    withName: UCSC_GTFTOGENEPRED {
        cpus = 2
        memory = 4.GB
        time = 1.h
        maxRetries = 2
    }
    withName: STAR_ALIGN {
        cpus = 8
        memory = 48.GB
        time = { 3.h * task.attempt }   // 3 → 6 → 9 → 12h across 4 attempts (maxRetries=3)
        maxRetries = 3
    }
    withName: TAG_CELL_BAM {
        cpus = 4
        memory = 8.GB
        time = { 2.h * task.attempt }   // 2 → 4 → 6h; 143/timeout retries need more wall-time
        maxRetries = 3
    }
    withName: FEATURECOUNTS_BAM {
        cpus = 8
        memory = 16.GB
        time = 2.h
        maxRetries = 3
    }
    withName: 'SAMTOOLS_SORT_CELL|SAMTOOLS_SORT_POS' {
        cpus = 8
        memory = 16.GB
        time = 1.h
        maxRetries = 3
    }
    withName: SAMTOOLS_STATS {
        cpus = 4
        memory = 8.GB
        time = 1.h
        maxRetries = 3
    }
    withName: 'SAMTOOLS_IDXSTATS|SAMTOOLS_FLAGSTAT' {
        cpus = 2
        memory = 4.GB
        time   = { 3.h * task.attempt }
        maxRetries = 3
    }
    withName: PICARD_COLLECTRNASEQMETRICS {
        cpus = 4
        memory = 16.GB
        time = 3.h
        maxRetries = 3
    }
    withName: BAM_TO_PARQUET {
        cpus = 8
        memory = 16.GB
        time = { 2.h * task.attempt }   // 2 → 4 → 6h; 143/timeout retries need more wall-time
        maxRetries = 2
    }
    withName: CATEGORIZE_READ_ASSIGNMENTS {
        cpus = 16
        memory = { task.attempt == 1 ? 60.GB : task.attempt == 2 ? 90.GB : 120.GB }
        time = 4.h
        maxRetries = 2
    }
    withName: IDENTIFY_FILTERED_POLONIES {
        cpus = 16
        memory = 32.GB
        time = 4.h
        maxRetries = 2
    }
    withName: MERGE_POLONY_PARQUETS {
        cpus = 16
        memory = 32.GB
        time = 4.h
        maxRetries = 2
    }
    withName: SPLIT_POLONY_PARQUETS {
        cpus = 8
        memory = 32.GB
        time = 4.h
        maxRetries = 2
    }
    withName: PROCESS_READ_ASSIGNMENTS {
        cpus = 8
        memory = 16.GB
        time = 4.h
        maxRetries = 2
    }
    withName: TAG_BAM {
        cpus = 4
        memory = { 16.GB + (task.attempt - 1) * 8.GB }  // 16 → 24 → 32; cpus stay put (join RAM is DuckDB, not thread-count)
        time = { 2.h * task.attempt }
        maxRetries = 2
    }
    withName: BUILD_SPATIALDATA {
        cpus = 12
        // Per-tile aligned F2P points peak ~23 GB on a large canvas; keep 64 GB start
        // with 96/128 retry ladder for large canvases. Time must clear build+zip
        // (~3.1 h on a large canvas); 3 h first attempt was too tight.
        memory = { 64.GB + (task.attempt - 1) * 32.GB }
        time = { 4.h * task.attempt }
        maxRetries = 2
    }
    withName: SPATIALDATA_QC_REPORT {
        cpus = 16
        memory = 32.GB
        time = 2.h
        maxRetries = 2
    }
    withName: COLLECT_SAMPLE_METRICS {
        cpus = 2
        memory = 4.GB
        time = 1.h
        maxRetries = 3
    }
    withName: AGGREGATE_F2P_METRICS {
        cpus = 2
        memory = 4.GB
        time = 1.h
        maxRetries = 3
    }
}