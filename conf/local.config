/*
========================================================================================
    Local execution profile
========================================================================================
    Execute on a single machine instead of a cloud executor. Sets only
    machine-local switches — it has no opinion on resources, so it must be
    paired with whichever profile sets the scale of the run:

        -profile docker,test,local       smoke run on one machine
        -profile docker,AVITI24,local    full run on one large machine

    Used alone, resources fall back to the generic tiers in conf/base.config
    (process_high = 12 CPU / 72 GB under a 48 CPU / 180 GB ceiling), which will
    not fit a workstation. Pair it, or pass your own resources with -c.

    `scratch` stages task inputs into a temporary directory and copies results
    back. On one machine that is pure overhead, so it is disabled. Note that
    conf/base.config enables it per-process by name for the four heaviest
    steps, and a withName selector beats a process-level default whatever the
    include order — so those four must be turned off individually.
----------------------------------------------------------------------------------------
*/
params {
    config_profile_name        = 'Local profile'
    config_profile_description = 'Single-machine execution'
}

cleanup = false

process {
    scratch = false

    // Must repeat per-process: conf/base.config sets scratch = true on these
    // four by name, which a process-level default cannot override.
    withName: BASES2FASTQ                       { scratch = false }
    withName: CELLS2STATS                       { scratch = false }
    withName: CELLS2STATS_SPATIALDATABUILD_VIZ  { scratch = false }
    withName: BUILD_SPATIALDATA                 { scratch = false }
}
