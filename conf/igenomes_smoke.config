/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Smoke-only iGenomes keys (CI / test configs)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included from conf/test.config and conf/nftest.config so default / Tower
    launches expose GRCh38 alone. GRCh38_chr20 is a chromosome-20 slice for
    fast smoke runs, not a production reference.
----------------------------------------------------------------------------------------
*/

params {
    genomes {
        'GRCh38_chr20' {
            fasta = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38_chr20/Sequence/WholeGenomeFasta/genome.fa"
            fasta_fai = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38_chr20/Sequence/WholeGenomeFasta/genome.fa.fai"
            genome_file = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38_chr20/Sequence/WholeGenomeFasta/genome.fa.genome"
            chrom_sizes = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38_chr20/Sequence/WholeGenomeFasta/genome.fa.chrom.sizes"
            genome_dict = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38_chr20/Sequence/WholeGenomeFasta/genome.fa.dict"
            bwa = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38_chr20/Sequence/BWAIndex/version0.6.0/"
            bowtie2 = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38_chr20/Sequence/Bowtie2Index/"
            star = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38_chr20/Sequence/STARIndex/"
            bismark = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38_chr20/Sequence/BismarkIndex/"
            gencode_gtf = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38_chr20/Annotation/Genes/gencode.v47.annotation.gtf"
            gencode_release = "47"
            bed12 = "${params.igenomes_base}/Homo_sapiens/NCBI/GRCh38_chr20/Annotation/Genes/genes.bed"
            mito_name = "chrM"
        }
    }
}
