/*
========================================================================================
    Config file for defining DSL2 per module options and publishing paths
========================================================================================
    Available keys to override module options:
        ext.args            = Additional arguments appended to command in module.
        ext.args2           = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3           = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix          = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: CELLS2STATS {

        // Preserve existing default of tarring program logs.
        // Module reads task.ext.tar_logs (custom ext.* attribute) instead of params.*.
        ext.tar_logs = { params.c2s_tar_program_logs ?: false }

        // ext.args translates params.c2s_* and shared filter_batch/tile/c2s_well
        // into cells2stats CLI flags. See upstream README "Module configuration
        // via task.ext.args" for the canonical pattern. Channel-input file paths
        // (run_panel, run_manifest, segmentation, tca_manifest) are wired in main.nf;
        // the module composes their CLI flags from the staged paths, not here.
        // Note: c2s_well is NOT supported in this workflow (b2f/c2s/spatialdata must
        // process the same wells) — main.nf forces params.c2s_well = [] at launch.
        ext.args = {
            def asList = { v -> v instanceof List ? v : (v ? [v] : []) }

            [
                // ── Logging ──────────────────────────────────────────────
                params.c2s_log_level                       ? "-l ${params.c2s_log_level}"                            : '-l info',
                // ── Shared filtering ─────────────────────────────────────
                params.filter_batch                        ? "--batch ${params.filter_batch}"                        : '',
                asList(params.tile).collect    { "--tile ${it}" }.join(' '),
                asList(params.c2s_well).collect{ "--well ${it}" }.join(' '),
                // ── Boolean toggles ──────────────────────────────────────
                params.c2s_error_on_missing                ? '--error-on-missing'                                    : '',
                params.c2s_no_error_on_invalid             ? '--no-error-on-invalid'                                 : '',
                params.c2s_skip_cellprofiler               ? '--skip-cellprofiler'                                   : '',
                params.c2s_skip_qc_report                  ? '--skip-qc-report'                                      : '',
                // ── Value flags ──────────────────────────────────────────
                params.c2s_max_unassigned                  ? "--max-unassigned ${params.c2s_max_unassigned}"         : '',
                // ── OPS / SpecializedTargeted ────────────────────────────
                params.c2s_target_mismatch_threshold != null
                    ? "--target-mismatch-threshold ${params.c2s_target_mismatch_threshold}"                          : '',
                params.c2s_specialized_targeted_min_query_length != null
                    ? "--specialized-targeted-min-query-length ${params.c2s_specialized_targeted_min_query_length}" : '',
                params.c2s_generate_specialized_targeted_bams
                    ? '--generate-specialized-targeted-bams'                                                         : '',
                // ── Targeted transcriptome (rc8+) ────────────────────────
                params.c2s_targeted_transcriptome_min_query_length != null
                    ? "--targeted-transcriptome-min-query-length ${params.c2s_targeted_transcriptome_min_query_length}" : '',
                params.c2s_targeted_transcriptome_mismatch_threshold != null
                    ? "--targeted-transcriptome-mismatch-threshold ${params.c2s_targeted_transcriptome_mismatch_threshold}" : '',
                params.c2s_targeted_transcriptome_min_insert_aligned != null
                    ? "--targeted-transcriptome-min-insert-aligned ${params.c2s_targeted_transcriptome_min_insert_aligned}" : '',
                params.c2s_generate_targeted_transcriptome_bams
                    ? '--generate-targeted-transcriptome-bams'                                                           : '',
                // ── Stitching / imaging (rc8+) ────────────────────────────
                params.c2s_static_overlap_stitching
                    ? '--static-overlap-stitching'                                                                   : '',
                params.c2s_disable_per_batch_background
                    ? '--disable-per-batch-background'                                                               : '',
                params.c2s_process_imaging_targets
                    ? '--process-imaging-targets'                                                                    : '',
                params.c2s_enable_illumination_correction
                    ? '--enable-illumination-correction'                                                             : '',
                params.c2s_disable_illumination_correction
                    ? '--disable-illumination-correction'                                                            : '',
                // ── Deprecated catch-all (use -c custom.config overlay instead) ──
                params.c2s_args ?: '',
            ].findAll().join(' ')
        }

        publishDir = [
            [   
                path: { "${params.outdir}/cells2stats/" },
                mode: params.publish_dir_mode,
                pattern: "*.{json,csv,log,parquet,viz,zip,json.gz}",
                optional: true,
            ],
            [
                path: { "${params.outdir}/cells2stats/" },
                mode: params.publish_dir_mode,
                pattern: "multiqc_report.html",
                optional: true,
            ],
            [
                path: { "${params.outdir}/cells2stats/multiqc/" },
                mode: params.publish_dir_mode,
                pattern: "multiqc/**",
                optional: true,
            ],
            [
                path: { "${params.outdir}/cells2stats/" },
                mode: params.publish_dir_mode,
                pattern: "Wells",
                optional: true,
            ],
            [
                path: { "${params.outdir}/cells2stats/" },
                mode: params.publish_dir_mode,
                pattern: "Logs{,.tar.gz}",
                optional: true,
            ],
            [
                path: { "${params.outdir}/cells2stats/" },
                mode: params.publish_dir_mode,
                pattern: "CellSegmentation",
                optional: true,
            ],
            [
                path: { "${params.outdir}/cells2stats/" },
                mode: params.publish_dir_mode,
                pattern: "SpatialData",
                enabled: params.c2s_publish_spatialdata,
                optional: true,
            ],
        ]
    }

    withName: CELLS2STATS_SPATIALDATABUILD_VIZ {

        // Gate execution on params.enable_c2s_viz (test profile sets it false).
        // Module reads task.ext.when at process-start; returning false skips the
        // process entirely without invoking the container.
        ext.when = { params.enable_c2s_viz }

        // ext.args translates params.c2s_visualization_workers /
        // c2s_viz_shape_smoothing_workers + log level into cells2stats
        // visualize CLI flags (rc12+). The SDO zip positional is composed by
        // the module from the staged input.
        //
        // Worker counts default from task.cpus so visualize uses the full
        // allocation (-j) rather than a 1-thread internal default. Shape
        // smoothing defaults to max(1, 2*cpus/3) (pipeline choice; c2s CLI
        // default is still cpus/3). Explicit params still override.
        ext.args = {
            def viz_workers    = params.c2s_visualization_workers       ?: task.cpus
            def smooth_workers = params.c2s_viz_shape_smoothing_workers ?: Math.max(1, ((task.cpus as int) * 2).intdiv(3))
            [
                // ── Logging ──────────────────────────────────────────────
                params.c2s_log_level ? "-l ${params.c2s_log_level}" : '-l info',
                // ── Viz tuning (rc12+ visualize) — always pass; sourced from task.* by default
                "--visualization-workers ${viz_workers}",
                "--viz-shape-smoothing-workers ${smooth_workers}",
                // ── Imaging — mirror the analyze-side toggle ──
                params.c2s_disable_per_batch_background
                    ? '--disable-per-batch-background' : '',
            ].findAll().join(' ')
        }

        publishDir = [
            [
                path: { "${params.outdir}/spatialdata/" },
                mode: params.publish_dir_mode,
                // rc12+ CytoCanvas v4 sidecars. Unique index suffixes — do not
                // use `*zarr-index.bin` (it also matches points/shapes indexes).
                pattern: "{cyto.viz,points-zarr.zip,cell-shapes-zarr.zip,nuclear-shapes-zarr.zip,*.zarr-index.bin,*.points-zarr-index.bin,*.cell-shapes-zarr-index.bin,*.nuclear-shapes-zarr-index.bin}",
                optional: true,
            ],
            [
                path: { "${params.outdir}/spatialdata/logs/" },
                mode: params.publish_dir_mode,
                pattern: "*.log",
                optional: true,
            ],
        ]
    }

    withName: CELLS2STATS_GENERATE_QC_REPORT {

        // External-facing Cell Painting QC (cells2stats generate_qc_report).
        // Distinct from SPATIALDATA_QC_REPORT (internal run-quality-report):
        // different container, output names (qc_report.html vs <run_id>.qc.*),
        // and publish dir (cells2stats/qc/ vs spatialdata/qc/).
        ext.when = { params.enable_c2s_qc_report }

        ext.args = {
            [
                params.c2s_log_level ? "-l ${params.c2s_log_level}" : '-l info',
            ].findAll().join(' ')
        }

        publishDir = [
            [
                path: { "${params.outdir}/cells2stats/qc/" },
                mode: params.publish_dir_mode,
                pattern: "qc_report*",
                optional: true,
            ],
            [
                path: { "${params.outdir}/cells2stats/logs/" },
                mode: params.publish_dir_mode,
                pattern: "run_generate_qc_report.log",
                optional: true,
            ],
        ]
    }

    withName: SPATIALDATA_QC_REPORT {

        // Master toggle; mirrors the CELLS2STATS_SPATIALDATABUILD_VIZ pattern.
        ext.when = { params.avsd_qc_enabled }

        // ext.args composes the user-tunable run-quality-report flags. The
        // mandatory --source / --output / --summary-tsv / --summary-json are
        // hard-coded in the module script (driven by the staged input + meta.id).
        ext.args = {
            [
                params.avsd_qc_run_analysis        ? "--run-analysis"     : '',
                params.avsd_qc_run_embedding       ? "--run-embedding"    : '',
                params.avsd_qc_advanced_metrics    ? "--advanced-metrics" : '',
                params.avsd_qc_show_filter_tabs    ? "--show-filter-tabs" : '',
                params.avsd_qc_analysis_subsample  != null
                    ? "--analysis-subsample-frac ${params.avsd_qc_analysis_subsample}"   : '',
                params.avsd_qc_embedding_subsample != null
                    ? "--embedding-subsample-frac ${params.avsd_qc_embedding_subsample}" : '',
                params.avsd_qc_cellpaint_subsample != null
                    ? "--cellpaint-subsample-frac ${params.avsd_qc_cellpaint_subsample}" : '',
                params.avsd_qc_metadata_table
                    ? "--metadata-table '${params.avsd_qc_metadata_table}'" : '',
                params.avsd_qc_report_title
                    ? "--report-title '${params.avsd_qc_report_title}'"     : '',
                params.avsd_qc_args ?: '',
            ].findAll().join(' ')
        }

        publishDir = [
            [
                path: { "${params.outdir}/spatialdata/qc/" },
                mode: params.publish_dir_mode,
                pattern: "*.qc.{html,tsv,json}",
            ],
            [
                path: { "${params.outdir}/spatialdata/logs/" },
                mode: params.publish_dir_mode,
                pattern: "*.qc.log",
            ],
        ]
    }

    withName: BASES2FASTQ {

        // ext.args translates params.b2f_* and shared filter_batch/tile into
        // bases2fastq CLI flags. See upstream README "Module configuration via
        // task.ext.args" for the canonical pattern. Channel-input file paths
        // (run_manifest, panel, tca_manifest, segmentation, analysis_region)
        // are wired in main.nf; the module composes their CLI flags from the
        // staged paths, not here.
        ext.args = {
            def asList = { v -> v instanceof List ? v : (v ? [v] : []) }

            // Tile include/exclude priority:
            //   b2f_include_tile takes priority; falls back to shared `tile` param.
            //   When includes are active, auto-exclude all tiles so includes work as a filter.
            def include_tile_list = asList(params.b2f_include_tile) ?: asList(params.tile)
            def exclude_tile_list = asList(params.b2f_exclude_tile) ?: (include_tile_list ? ['L.R..C..S.'] : [])

            [
                // ── Logging ──────────────────────────────────────────────
                params.b2f_log_level               ? "-l ${params.b2f_log_level}"                : '',
                // ── Boolean toggles ──────────────────────────────────────
                params.b2f_demux_only                     ? '--demux-only'                       : '',
                params.b2f_detect_adapters                ? '--detect-adapters'                  : '',
                params.b2f_error_on_missing               ? '--error-on-missing'                 : '',
                params.b2f_no_error_on_invalid            ? '--no-error-on-invalid'              : '',
                params.b2f_no_projects                    ? '--no-projects'                      : '',
                params.b2f_legacy_fastq                   ? '--legacy-fastq'                     : '',
                params.b2f_qc_only                        ? '--qc-only'                          : '',
                params.b2f_skip_empty_fq_files            ? '--skip-empty-fq-files'              : '',
                params.b2f_skip_multi_qc                  ? '--skip-multi-qc'                    : '',
                params.b2f_skip_qc_report                 ? '--skip-qc-report'                   : '',
                params.b2f_split_lanes                    ? '--split-lanes'                      : '',
                params.b2f_group_fastq                    ? '--group-fastq'                      : '',
                params.b2f_force_detect_index_orientation ? '--force-detect-index-orientation'   : '',
                params.b2f_force_index_orientation        ? '--force-index-orientation'          : '',
                params.b2f_per_target_fastq               ? '--per-target-fastq'                 : '',
                // ── Value flags ──────────────────────────────────────────
                params.b2f_num_unassigned          ? "--num-unassigned ${params.b2f_num_unassigned}"     : '',
                params.b2f_filter_mask             ? "--filter-mask ${params.b2f_filter_mask}"           : '',
                params.b2f_flowcell_id             ? "--flowcell-id ${params.b2f_flowcell_id}"           : '',
                params.b2f_cyto_fastq_mask         ? "--cyto-fastq-mask ${params.b2f_cyto_fastq_mask}"   : '',
                // ── Shared filter ────────────────────────────────────────
                params.filter_batch                ? "--batch ${params.filter_batch}"            : '',
                // ── Tile include/exclude (priority logic above) ──────────
                exclude_tile_list.collect { "--exclude-tile '${it}'" }.join(' '),
                include_tile_list.collect { "--include-tile '${it}'" }.join(' '),
                // ── List flags ───────────────────────────────────────────
                asList(params.b2f_settings).collect { "--settings '${it}'" }.join(' '),
                // ── Deprecated catch-all (use -c custom.config overlay instead) ──
                params.b2f_args ?: '',
            ].findAll().join(' ')
        }

        publishDir = [
            [
                path: { "${params.outdir}/bases2fastq/" },
                mode: params.publish_dir_mode,
                pattern: "*.{json,csv,html,parquet,log}"
            ],
            [
                path: { "${params.outdir}/bases2fastq/" },
                mode: params.publish_dir_mode,
                pattern: "Samples/*/*.{json,fastq.gz}"
            ],
            [
                path: { "${params.outdir}/bases2fastq/" },
                mode: params.publish_dir_mode,
                pattern: "info/*.{log}"
            ]
        ]
    }

    withName: GTF_PREPROCESSING {
        publishDir = [
            path: { "${params.outdir}/fastq2parquet_3prime/genes/gtf" },
            mode: params.publish_dir_mode,
            pattern: "*.{log,gtf.gz,gtf.gz.tbi}"
        ]
    }

    withName: STAR_ALIGN {
        publishDir = [
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/alignment/star/" },
                mode: params.publish_dir_mode,
                pattern: "*.{log,star.bam,star.bam.bai}"
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/alignment/chimera/" },
                mode: params.publish_dir_mode,
                pattern: "*.{log,star.chimeric.bam,star.chimeric.bam.bai}"
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/alignment/star_log/" },
                mode: params.publish_dir_mode,
                pattern: "*.{log,out}"
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/alignment/star_counts/" },
                mode: params.publish_dir_mode,
                pattern: "*.{log,tab}"
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/bedgraph/star/" },
                mode: params.publish_dir_mode,
                pattern: "*.{log,bg.gz,bg.gz.tbi}"
            ]
        ]
    }

    withName: TAG_CELL_BAM {
        ext.prefix = { "${meta.id}.star" }
        publishDir = [
            path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/alignment/tagged/" },
            mode: params.publish_dir_mode,
            pattern: "*.{log}"
        ]
    }

    withName: FEATURECOUNTS_BAM {
        ext.prefix = { "${meta.id}" }
        // Annotation is now a SAF (built by GENERATE_FEATURE_SAF / gen-feature-bed).
        // Slop is baked into the SAF intervals, so --readExtension5/3 are dropped.
        // -F SAF tells featureCounts to use the SAF format (GeneID/Chr/Start/End/Strand).
        // -O is FORCED ON for the 1.2.5 featureCounts+rank engine: it must enumerate
        // EVERY overlapped (gene|tier) GeneID per read into the XT tag so diss-tools can
        // rank them. Without -O, ambiguous reads are dropped at the engine and the rank
        // collapse has no candidate set.
        ext.args = [
            "-F SAF",                                            // SAF annotation format
            "-s 2",                                              // reverse stranded
            params.f2p_3p_count_multimapping_reads ? "-M" : "",
            "-O"                                                 // forced on (rank engine needs the overlap enumeration)
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/alignment/featurecounts/" },
            mode: params.publish_dir_mode,
            pattern: "*.{featureCounts.txt.gz,featureCounts.txt.summary}"
        ]
    }

    withName: SAMTOOLS_SORT_CELL {
        ext.prefix = { "${meta.id}.star.cell" }
        ext.args = "-n -t CB:Z"  // sort by name using CB tag
        publishDir = [
            path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/alignment/cell_sorted/" },
            mode: params.publish_dir_mode,
            pattern: "*.{bam}"
        ]
    }

    withName: SAMTOOLS_SORT_POS {
        ext.prefix = { "${meta.id}.star.tagged" }
        // default coordinate sort. Not published: the canonical output BAM is the
        // Z*-tagged TAG_BAM output, a superset of this one (+ per-read decision
        // tags). Downstream stats/picard consume the channel, not the published file.
        publishDir = [ enabled: false ]
    }

    withName: SAMTOOLS_STATS {
        ext.prefix = { "${meta.id}.star.tagged" }
        publishDir = [
            path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/samtools/stats/" },
            mode: params.publish_dir_mode,
            pattern: "*.stats"
        ]
    }

    withName: SAMTOOLS_IDXSTATS {
        ext.prefix = { "${meta.id}.star.tagged" }
        publishDir = [
            path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/samtools/idxstats/" },
            mode: params.publish_dir_mode,
            pattern: "*.idxstats"
        ]
    }

    withName: SAMTOOLS_FLAGSTAT {
        ext.prefix = { "${meta.id}.star.tagged" }
        publishDir = [
            path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/samtools/flagstat/" },
            mode: params.publish_dir_mode,
            pattern: "*.flagstat"
        ]
    }

    withName: UCSC_GTFTOGENEPRED {
        ext.args = '-genePredExt -geneNameAsName2'
        publishDir = [
            path: { "${params.outdir}/fastq2parquet_3prime/ref/" },
            mode: params.publish_dir_mode,
            pattern: "*.{refflat,genepred}"
        ]
    }

    withName: PICARD_COLLECTRNASEQMETRICS {
        ext.prefix = { "${meta.id}.star.tagged" }
        // Reverse-stranded 3' assay (featureCounts -s 2) -> SECOND_READ_TRANSCRIPTION_STRAND,
        // which populates CORRECT_STRAND_READS / INCORRECT_STRAND_READS / PCT_CORRECT_STRAND_READS
        // (sense-vs-antisense-to-gene = strand specificity, surfaced as StrandSpecificity in RunStats).
        // If a re-gate shows PCT_CORRECT_STRAND_READS inverted (~0% on a healthy run), flip to FIRST.
        ext.args = '--STRAND_SPECIFICITY SECOND_READ_TRANSCRIPTION_STRAND'
        publishDir = [
            path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/picard/rna_metrics/" },
            mode: params.publish_dir_mode,
            pattern: "*.rna_metrics"
        ]
    }

    withName: BAM_TO_PARQUET {
        publishDir = [
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/logs/" },
                mode: params.publish_dir_mode,
                pattern: "*.log",
                saveAs: { "bam_to_parquet.log" }
            ]
        ]
    }

    withName: GENERATE_FEATURE_SAF {
        publishDir = [
            [
                path: { "${params.outdir}/fastq2parquet_3prime/feature_set/" },
                mode: params.publish_dir_mode,
                pattern: "*.{saf.bed,saf.bed.gz,saf.bed.gz.tbi,extensions_for_igv.bed}"
            ],
            // Stable names under genes/ so rebuilds / auditors can find the
            // selected ThreePrime catalog without digging work dirs or zarr inputs.
            [
                path: { "${params.outdir}/fastq2parquet_3prime/genes/" },
                mode: params.publish_dir_mode,
                pattern: "*.intervals_metadata.tsv",
                saveAs: { "intervals_metadata.tsv" }
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/genes/" },
                mode: params.publish_dir_mode,
                pattern: "*.gene_metadata.tsv",
                saveAs: { "gene_metadata.tsv" }
            ]
        ]
    }

    withName: APPLY_READ_FILTER {
        // Soft-clip read filter (runs only when f2p_3p_read_filter_enabled). Publishes
        // the filtered polony parquet (the one PROCESS / TAG_BAM / MERGE then consume).
        publishDir = [
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/reads/" },
                mode: params.publish_dir_mode,
                pattern: "*_reads.parquet",
                saveAs: { filename -> filename.replace('_reads.parquet', '_filteredreads.parquet') }
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/logs/" },
                mode: params.publish_dir_mode,
                pattern: "*.log",
                saveAs: { "apply_read_filter.log" }
            ]
        ]
    }

    withName: CATEGORIZE_READ_ASSIGNMENTS {
        // 80% DuckDB; a large well OOM'd at 60% of 60 GB (36 GB limit).
        ext.args = '--duckdb-memory-fraction 0.8'
        publishDir = [
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/reads/" },
                mode: params.publish_dir_mode,
                pattern: "*_reads.parquet",
                saveAs: { filename -> filename.replace('_reads.parquet', '_fastqreads.parquet') }
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/resolver/" },
                mode: params.publish_dir_mode,
                pattern: "*.resolver_metrics.tsv"
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/logs/" },
                mode: params.publish_dir_mode,
                pattern: "*.log",
                saveAs: { "categorize_read_assignments.log" }
            ]
        ]
    }

    withName: TAG_BAM {
        // Always on: the Z*-tagged, position-sorted BAM is the canonical output BAM
        // (carries CB + featureCounts XT candidates + the per-read rank decision Z* tags).
        ext.prefix = { "${meta.id}.star.tagged.polony" }
        publishDir = [
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/bam/" },
                mode: params.publish_dir_mode,
                pattern: "*.tagged.polony.bam{,.bai}"
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/logs/" },
                mode: params.publish_dir_mode,
                pattern: "*.log",
                saveAs: { "tag_bam.log" }
            ]
        ]
    }

    withName: IDENTIFY_FILTERED_POLONIES {
        publishDir = [
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/reads/" },
                mode: params.publish_dir_mode,
                pattern: "*_filteredreads.parquet"
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/summary/" },
                mode: params.publish_dir_mode,
                pattern: "*_filteredreads_summary.json"
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/logs/" },
                mode: params.publish_dir_mode,
                pattern: "*.log",
                saveAs: { "identify_filtered_polonies.log" }
            ]
        ]
    }

    withName: MERGE_POLONY_PARQUETS {
        publishDir = [
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/reads/" },
                mode: params.publish_dir_mode,
                pattern: "*_reads.parquet"
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/logs/" },
                mode: params.publish_dir_mode,
                pattern: "*.log",
                saveAs: { "merge_polony_parquets.log" }
            ]
        ]
    }

    withName: SPLIT_POLONY_PARQUETS {
        publishDir = [
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/" },
                mode: params.publish_dir_mode,
                pattern: "*_Wells"
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/logs/" },
                mode: params.publish_dir_mode,
                pattern: "*.log",
                saveAs: { "split_polony_parquets.log" }
            ]
        ]
    }

    withName: PROCESS_READ_ASSIGNMENTS {
        publishDir = [
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/qc/" },
                mode: params.publish_dir_mode,
                pattern: "*.{polony-qc_reads.parquet,cell-qc_reads.parquet}"
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/summary/" },
                mode: params.publish_dir_mode,
                pattern: "*.{csv.gz,cell_read_counts_summary.parquet,biotype-metrics.tsv,tier-metrics.tsv}"
            ],
            [
                path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/polonies/logs/" },
                mode: params.publish_dir_mode,
                pattern: "*.log",
                saveAs: { "process_read_assignments.log" }
            ]
        ]
    }

    withName: BUILD_SPATIALDATA {
        // Note: Optional TCA manifest files may not exist for non-SpecializedTargeted runs.
        // Nextflow will show "No such file" errors during staging, but the process
        // handles missing files gracefully by checking existence in the script.
        // These errors can be safely ignored.
        // --fail-on-missing-batches is opt-in; default build-spatialdata is lenient
        // (warn + record uns['missing_batches']). Unaligned present-data batches are
        // never treated as missing regardless of this flag.
        ext.args = { params.avsd_fail_on_missing_batches ? '--fail-on-missing-batches' : '' }
        publishDir = [
            [
                path: { "${params.outdir}/spatialdata/" },
                mode: params.publish_dir_mode,
                pattern: "*.{zarr,zip}"
            ],
            [
                path: { "${params.outdir}/spatialdata/logs/" },
                mode: params.publish_dir_mode,
                pattern: "*.{log,json}"
            ]
        ]
    }

    withName: COLLECT_SAMPLE_METRICS {
        publishDir = [
            path: { "${params.outdir}/fastq2parquet_3prime/Samples/${meta.id}/metrics/" },
            mode: params.publish_dir_mode,
            pattern: "*.json"
        ]
    }

    withName: AGGREGATE_F2P_METRICS {
        publishDir = [
            path: { "${params.outdir}/fastq2parquet_3prime/" },
            mode: params.publish_dir_mode,
            pattern: "RunStats.json"
        ]
    }
}
