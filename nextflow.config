params {
    
    // ═══════════════════════════════════════════════════════════════════════════
    // INPUT / OUTPUT
    // ═══════════════════════════════════════════════════════════════════════════
    
    run_dir                                 = null
    id                                      = null
    run_parameters_json                     = null
    run_manifest_csv                        = null
    tca_manifest_csv                        = null      // Shared TCA for b2f + c2s (prefer over per-tool overrides)
    outdir                                  = './results'
    
    // ═══════════════════════════════════════════════════════════════════════════
    // SHARED OPTIONS (applied to both cells2stats and bases2fastq)
    // ═══════════════════════════════════════════════════════════════════════════
    
    filter_batch                            = null      // Restrict to batch(es), comma-delimited (e.g. B01,B02,B03)
    tile                                    = []        // Tile regex pattern(s) — drives b2f -i, c2s --tile, and build_spatialdata --tile-filter
    segmentation_dir                        = null      // Custom cell segmentation directory (c2s --segmentation, future b2f support)
    analysis_region_dir                     = null      // Custom AnalysisRegion directory override, build-spatialdata only (c2s keeps reading run-dir/AnalysisRegion)
    
    // ═══════════════════════════════════════════════════════════════════════════
    // CELLS2STATS (c2s)
    // ═══════════════════════════════════════════════════════════════════════════
    
    // General options
    c2s_error_on_missing                    = false     // Terminate on missing file
    c2s_log_level                           = "info"    // debug, info, warning, error
    c2s_max_unassigned                      = 1000      // Limit unassigned sequences (1-10000)
    c2s_no_error_on_invalid                 = false     // Skip invalid files
    c2s_panel_json                          = null      // Path to panel JSON
    c2s_run_manifest                        = null      // Path to run manifest (.csv or .json)
    c2s_skip_cellprofiler                   = false     // Skip cellprofiler execution
    c2s_skip_qc_report                      = true      // Skip analyze's Cell Painting qc_report.html (rc9 --skip-qc-report); the published report comes from CELLS2STATS_GENERATE_QC_REPORT
    c2s_tca_manifest_csv                    = null      // Advanced: c2s-only TCA; prefer tca_manifest_csv so b2f/c2s stay identical
    c2s_well                                = []        // Well filter(s) — not supported here (b2f/c2s/spatialdata must match)
    c2s_tar_program_logs                    = true     // Tar/gz the Logs directory; when false, publish as directory
    c2s_publish_spatialdata                 = false    // Publish c2s-internal SpatialData/ under cells2stats/; canonical SpatialData is built by BUILD_SPATIALDATA
    c2s_args                                = ""        // Additional custom args

    // OPS / specialized targeted options (rc8+)
    c2s_target_mismatch_threshold              = null   // --target-mismatch-threshold N (0-4); overrides TCA manifest
    c2s_specialized_targeted_min_query_length  = null   // --specialized-targeted-min-query-length LENGTH (>=12)
    c2s_generate_specialized_targeted_bams     = false  // --generate-specialized-targeted-bams

    // Targeted transcriptome analyze options (rc8+)
    c2s_targeted_transcriptome_min_query_length   = null   // --targeted-transcriptome-min-query-length LENGTH (>=12)
    c2s_targeted_transcriptome_mismatch_threshold = null   // --targeted-transcriptome-mismatch-threshold N (0-10)
    c2s_targeted_transcriptome_min_insert_aligned = null   // --targeted-transcriptome-min-insert-aligned N (>=0; default 9)
    c2s_generate_targeted_transcriptome_bams      = false  // --generate-targeted-transcriptome-bams

    // analyze stitching / imaging (rc8+)
    c2s_static_overlap_stitching            = false     // --static-overlap-stitching
    c2s_disable_per_batch_background        = false     // --disable-per-batch-background (default keeps Bkg_RED/Bkg_GRN)
    c2s_process_imaging_targets             = false     // --process-imaging-targets (in-place Projection reprocess before analyze)

    // analyze illumination correction override (rc12+; requires c2s_process_imaging_targets)
    c2s_enable_illumination_correction      = false     // --enable-illumination-correction (force on for all imaging targets)
    c2s_disable_illumination_correction     = false     // --disable-illumination-correction (force off for all imaging targets)

    // visualize / generate_qc_report (rc12+ viz worker model; DuckDB sort knobs removed)
    enable_c2s_viz                          = true      // Run CELLS2STATS_SPATIALDATABUILD_VIZ (cells2stats visualize); set false to skip
    enable_c2s_qc_report                    = true      // Run CELLS2STATS_GENERATE_QC_REPORT (external CP qc_report.html); set false to skip
    c2s_visualization_workers               = null      // --visualization-workers N (default: task.cpus)
    c2s_viz_shape_smoothing_workers         = null      // --viz-shape-smoothing-workers N (default: max(1, 2 * task.cpus / 3))

    
    // ═══════════════════════════════════════════════════════════════════════════
    // BASES2FASTQ (b2f)
    // ═══════════════════════════════════════════════════════════════════════════
    
    // General options
    b2f_demux_only                          = false
    b2f_detect_adapters                     = false
    b2f_error_on_missing                    = false
    b2f_exclude_tile                        = []        // Tile exclusion patterns (list)
    b2f_force_index_orientation             = false
    b2f_force_detect_index_orientation      = false     // --force-detect-index-orientation (b2f >= 2.4.0-internal)
    b2f_group_fastq                         = false
    b2f_include_tile                        = []        // Tile inclusion patterns (list); falls back to shared tile param if empty
    b2f_legacy_fastq                        = false     // Legacy naming (SampleName_S1_L001_R1_001.fastq.gz)
    b2f_log_level                           = "INFO"    // DEBUG, INFO, WARNING, ERROR
    b2f_no_error_on_invalid                 = false
    b2f_no_projects                         = true      // Disable project directories
    b2f_num_unassigned                      = 30        // Max unassigned sequences to report
    b2f_qc_only                             = false
    b2f_skip_empty_fq_files                 = false     // --skip-empty-fq-files (b2f >= 2.4.0-internal)
    b2f_skip_multi_qc                       = false
    b2f_skip_qc_report                      = false
    b2f_split_lanes                         = false
    b2f_args                                = ""        // Additional custom args

    // Value flags (from public repo convergence)
    b2f_filter_mask                         = null      // --filter-mask value
    b2f_flowcell_id                         = null      // --flowcell-id value

    // List flags (from public repo convergence)
    b2f_settings                            = []        // Repeated --settings 'key,val'
    
    // Cyto-fastq options
    b2f_cyto_fastq_mask                     = null      // Cycle mask for cyto fastq generation
    b2f_panel_json                          = null      // Path to panel JSON
    b2f_per_target_fastq                    = false     // Create per-target fastq for each cell assignment target
    b2f_tca_manifest_csv                    = null      // Advanced: b2f-only TCA; prefer tca_manifest_csv so b2f/c2s stay identical
    
    // ═══════════════════════════════════════════════════════════════════════════
    // FASTQ2PARQUET (f2p) — shared across all batch-type subworkflows
    // ═══════════════════════════════════════════════════════════════════════════
    
    // Sample selection
    ignore_samples                          = ["Unassigned", "PhiX", "phiX", "CBPhiX", "Undetermined"]
    
    // Assay type channel mapping
    // Configure which Panel.json AssayTypes map to each category
    f2p_three_prime_types                   = ["ThreePrimeUntargeted", "Transcript"]    // -> FASTQ2PARQUET_3PRIME
    f2p_specialized_types                   = ["SpecializedTargeted"]                   // -> future subworkflow
    f2p_targeted_tx_types                   = ["TargetedTranscriptomeProfiling"]        // -> future subworkflow
    
    // Fastq2Parquet QC params
    f2p_qc_sample_size                      = 250000
    f2p_qc_cell_sample_size                 = 500
    f2p_batch_size                          = 100000

    // Reference genome
    genome                                  = 'GRCh38'   // selects every reference (FASTA, STAR index, GENCODE GTF) from igenomes_base
    igenomes_base                           = 's3://elembio-static-public-244107694630-us-west-2/igenomes'  // Element reference bucket (STAR 2.7 indexes + GENCODE GTF)
    igenomes_ignore                         = false      // true: supply --fasta, --star_index and --genes_gtf together
    genes_gtf                               = null       // overrides the genome's GENCODE GTF; required with igenomes_ignore
    genes_bed12                             = null
    
    // STAR alignment (3' STAR_ALIGN). Named modes match RNA2counts star_mode /
    // the RNA2counts star_mode presets. Default is STAR
    // native stringency (star_default). Override with --star_mode or
    // -profile star_default / star_relaxed. Individual STAR knobs are optional
    // explicit overrides applied after the selected named mode.
    star_ignore_sjdbgtf                     = true
    star_twopassmode                        = "Basic"
    star_align_ends_type                    = "Local"
    star_mode                               = 'star_default'
    star_profiles                           = [
        'star_default': [
            outFilterMultimapNmax: 5,
            outSAMmultNmax: 5,
            outFilterMatchNmin: 0,
            outFilterScoreMinOverLread: 0.66,
            outFilterMatchNminOverLread: 0.66,
            alignSJoverhangMin: 5,
            chimSegmentMin: 12
        ],
        // Pre-1.10.0 / 1.9.7 DiSS-relaxed stringency (A/B vs star_default).
        'relaxed': [
            outFilterMultimapNmax: 10,
            outSAMmultNmax: 10,
            outFilterMatchNmin: 15,
            outFilterScoreMinOverLread: 0.2,
            outFilterMatchNminOverLread: 0.1,
            alignSJoverhangMin: 5,
            chimSegmentMin: 12
        ],
        'diss_strict': [
            outFilterMultimapNmax: 5,
            outSAMmultNmax: 5,
            outFilterMatchNmin: 15,
            outFilterScoreMinOverLread: 0.66,
            outFilterMatchNminOverLread: 0.66,
            alignSJoverhangMin: 8,
            chimSegmentMin: 15
        ],
        'diss_balanced': [
            outFilterMultimapNmax: 5,
            outSAMmultNmax: 5,
            outFilterMatchNmin: 15,
            outFilterScoreMinOverLread: 0.55,
            outFilterMatchNminOverLread: 0.55,
            alignSJoverhangMin: 5,
            chimSegmentMin: 12
        ],
        'diss_sensitive': [
            outFilterMultimapNmax: 5,
            outSAMmultNmax: 5,
            outFilterMatchNmin: 15,
            outFilterScoreMinOverLread: 0.40,
            outFilterMatchNminOverLread: 0.40,
            alignSJoverhangMin: 5,
            chimSegmentMin: 15
        ],
        'diss_permissive': [
            outFilterMultimapNmax: 5,
            outSAMmultNmax: 5,
            outFilterMatchNmin: 15,
            outFilterScoreMinOverLread: 0.2,
            outFilterMatchNminOverLread: 0.1,
            alignSJoverhangMin: 5,
            chimSegmentMin: 8
        ]
    ]
    star_outFilterMultimapNmax              = null
    star_outSAMmultNmax                     = null
    star_outFilterMatchNmin                 = null
    star_outFilterScoreMinOverLread         = null
    star_outFilterMatchNminOverLread        = null
    star_alignSJoverhangMin                 = null
    star_chimSegmentMin                     = null
    
    // ═══════════════════════════════════════════════════════════════════════════
    // FASTQ2PARQUET_3PRIME (f2p_3p) — three-prime untargeted specific
    // ═══════════════════════════════════════════════════════════════════════════
    
    // Feature assignment (featureCounts -F SAF). The SAF is built by
    // gen-feature-bed (elembio-diss-tools) and bakes the slop intervals
    // directly into the annotation rows, so --readExtension5/3 are no
    // longer needed at the featureCounts step.
    f2p_3p_count_multimapping_reads         = true
    f2p_3p_count_overlapping_reads          = true

    // gen-feature-bed knobs (Phase 7 levers)
    f2p_3p_slop_5p_bp                       = 200    // 5′ extension into CDS
    f2p_3p_slop_3p_bp                       = 100    // 3′ extension past the gene's 3′ terminus (3′UTR end, or terminal-exon end for UTR-less genes)
    f2p_3p_features                         = "utr,exon,chrm"  // SINGLE source of truth for tier-group selection. exon-union model: 3'UTR tiers + exon (catches UTR-less genes; synthetic dropped) + chrM umbrella. To count introns, add the tier: "utr,exon,intron,chrm". (1.8.2 removed the additive include_intron/include_chrm_umbrella booleans.)
    f2p_3p_unique_only_tiers                = "intron"  // 1.6.0: feature tiers counted UNIQUE-ONLY (multi_simple dropped) -> diss --unique-only-categories; comma-sep; inert unless that tier is included. Default keeps the intron tier unique-only when enabled.
    f2p_3p_include_gene_types               = "protein_coding,lncRNA"  // 1.2.0 default: PC + lncRNA (requires full v47 GTF per-run)
    f2p_3p_exclude_gene_types               = ""
    // f2p_3p_full_annotation_summary / _downsample RETIRED (1.10.0): exact
    // TotalReadsUnassignedUnselected / NoOverlap come from the primary polony
    // parquet (IsAnnotated ∧ ¬IsAssigned). The sampled FEATURECOUNTS_FULL_* path
    // and collect-sample-metrics --full-parquet-* flags are gone.

    // Read counting (elembio-diss-tools)
    f2p_3p_count_simple_multimapping_reads  = true

    // Assignment engine (elembio-diss-tools 0.15.0 / workflow 1.2.5): featureCounts+rank
    // is now the SOLE engine — featureCounts (span, -O) enumerates overlaps on the
    // tier-encoded SAF and diss-tools ranks them. The old f2p_3p_use_polya_point_resolver
    // toggle is RETIRED (the duckdb point resolver was removed in 0.15.0).
    f2p_3p_rescue_gene_family               = false  // HGNC gene-family rescue in the rank collapse; needs f2p_3p_hgnc_gene_groups
    f2p_3p_hgnc_gene_groups                 = null   // path to HGNC groups TSV (hgnc_complete_set.txt | gene_has_family.csv)
    f2p_3p_strandedness                     = "reverse"  // matches featureCounts -s 2
    f2p_3p_resolver_metrics                 = true   // emit the engine all-records aggregate metrics TSV
    // NOTE: the Z* decision-tagged BAM is now always produced (TAG_BAM) and is the
    // canonical output BAM — no f2p_3p_tag_bam toggle.

    // Optional post-alignment soft-clip filter on the count matrix (diss-tools 0.29.0).
    // BINARY: APPLY_READ_FILTER runs only when f2p_3p_read_filter_enabled is true, and
    // when it runs it ALWAYS enforces (removes softclip-failing reads from the matrix;
    // prelim gene kept in winner_gene). Disabled (default) ⇒ the step is skipped and
    // the matrix is unchanged. Soft-clip only — base-quality PF is applied upstream in
    // bases2fastq. Kept as an extensible home for future post-alignment rules. The
    // always-on read_quality soft-clip distribution (ReadQualitySoftclipOver*) is
    // emitted regardless.
    f2p_3p_read_filter_enabled              = false  // run + enforce the soft-clip filter. default off ⇒ matrix unchanged
    f2p_3p_read_filter_softclip_max         = 50     // max read_min_softclip (%) to pass

    // Filtered polony identification
    enable_identify_filtered_polonies       = true
    
    
    // ═══════════════════════════════════════════════════════════════════════════
    // BUILD_SPATIALDATA (avsd build)
    // ═══════════════════════════════════════════════════════════════════════════
    
    avsd_zip_spatialdata                            = true
    avsd_merge_strategy_protein                     = "expand_features"
    avsd_merge_strategy_transcript                  = "expand_features"
    avsd_merge_strategy_ops                         = "independent_features"
    avsd_merge_strategy_three_prime_untargeted      = "aggregate_features"
    avsd_dask_write_threads                         = 2
    avsd_per_worker_lib_threads                     = 2         // OMP/OpenBLAS/MKL/NumExpr per worker process (onboard kAggregationPythonPerWorkerLibThreads); POLARS_MAX_THREADS follows task.cpus
    avsd_points_blocksize                           = "32 MiB"  // Caps per-partition pandas memory for points reads (build-spatialdata --points-blocksize); '' inherits upstream parquet row groups
    avsd_debug_preserve_inputs                      = false
    avsd_fail_on_missing_batches                    = false     // --fail-on-missing-batches; raise only when Panel-declared count batch has no points parquets

    // ═══════════════════════════════════════════════════════════════════════════
    // BUILD_SPATIALDATA QC HTML REPORT (avsd_qc) — optional run-quality report
    // Off by default. Requires spatialdata_analysis_container_url/_tag to be set
    // by the launching profile; the image is not part of the public release.
    // Distinct from enable_c2s_qc_report (cells2stats generate_qc_report).
    // ═══════════════════════════════════════════════════════════════════════════

    avsd_qc_enabled                                 = false     // master on/off for SPATIALDATA_QC_REPORT (needs spatialdata_analysis_container_*)
    avsd_qc_run_analysis                            = true      // --run-analysis (Analysis tab; CPU)
    avsd_qc_run_embedding                           = false     // --run-embedding (per-modality HVG+PCA+UMAP; reserved for a future GPU profile)
    avsd_qc_advanced_metrics                        = false     // --advanced-metrics (ADV-tagged sections)
    avsd_qc_show_filter_tabs                        = false     // --show-filter-tabs
    avsd_qc_analysis_subsample                      = null      // override --analysis-subsample-frac
    avsd_qc_embedding_subsample                     = null      // override --embedding-subsample-frac
    avsd_qc_cellpaint_subsample                     = null      // override --cellpaint-subsample-frac
    avsd_qc_metadata_table                          = null      // override --metadata-table
    avsd_qc_report_title                            = null      // override --report-title
    avsd_qc_args                                    = ""        // free-form extra args passed to run-quality-report

    // ═══════════════════════════════════════════════════════════════════════════
    // INFRASTRUCTURE
    // ═══════════════════════════════════════════════════════════════════════════
    
    // Containers — defaults are the release images this version was validated with.
    // Override any url/tag at launch (CLI, -params-file, Tower form) or via a
    // profile (Element-internal pins: conf/internal.config).
    // main.nf fails fast when any of the first eight is unset.
    c2s_container_url                       = "904220683607.dkr.ecr.us-west-2.amazonaws.com/cells2stats-release"
    c2s_container_tag                       = "2.0.0"
    b2f_container_url                       = "904220683607.dkr.ecr.us-west-2.amazonaws.com/bases2fastq-release"
    b2f_container_tag                       = "3.0.0"
    elembiodisstools_container_url          = "904220683607.dkr.ecr.us-west-2.amazonaws.com/elembio-diss-tools-release"
    elembiodisstools_container_tag          = "1.0.0"
    spatialdata_build_container_url         = "904220683607.dkr.ecr.us-west-2.amazonaws.com/elembio-spatialdata-build-release"
    spatialdata_build_container_tag         = "1.0.0"
    spatialdata_analysis_container_url      = ''    // optional run-quality report image (see avsd_qc)
    spatialdata_analysis_container_tag      = ''
    
    // Resource limits
    max_memory                              = '180.GB'
    max_cpus                                = 48
    max_time                                = '48.h'
    
    // Publishing
    publish_dir_mode                        = 'copy'
    tracedir                                = "${params.outdir}/pipeline_info"
    
    // Config profiles
    custom_config_version                   = "main"
    custom_config_base                      = "https://raw.githubusercontent.com/Elembio/configs/${params.custom_config_version}"
    config_profile_name                     = null
    
    // Misc
    enable_conda                            = false
}

fusion.enabled = false
wave.enabled = false

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Load nf-core custom profiles from different institutions.
// Canonical nf-core pattern: ternary falls back to /dev/null when NXF_OFFLINE
// is set (or when params.custom_config_base is empty). Strict syntax (NF >=26.04)
// forbids try/catch around includeConfig.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Load the pipeline-specific custom config from Elembio/configs.
// Requires `pipeline/elembio-multiomics-nf.config` to exist in that repo.
// Dual-identity: public/apply-identity.sh rewrites the basename for the public tree.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/elembio-multiomics-nf.config" : "/dev/null"

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

manifest {
    name            = 'Elembio/elembio-multiomics-nf'
    author          = 'Bryan R Lajoie, Carlos Ruiz, Andrew Altomare, Rosi Bajari, Max Mass, Charles Adapon'
    homePage        = 'https://github.com/Elembio/elembio-multiomics-nf'
    description     = 'Element Biosciences AVITI24 multiomics secondary analysis: cytoprofiling (cells2stats), spatial FASTQ generation (bases2fastq), 3-prime untargeted RNA counting, and SpatialData assembly'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
    version         = '2.0.1'
}

profiles {
    docker {
        docker.enabled         = true
        singularity.enabled    = false
        podman.enabled         = false
        shifter.enabled        = false
        charliecloud.enabled   = false
    }

    test { includeConfig 'conf/test.config' }
    local { includeConfig 'conf/local.config' }
    fusion { includeConfig 'conf/fusion.config' }
    AVITI24 { includeConfig 'conf/AVITI24.config' }
    AVITI { includeConfig 'conf/AVITI24.config' }   // alias of AVITI24, kept for existing launch templates
    tower_spot { includeConfig 'conf/tower_spot.config' }
    // Element-internal values: container pins, reference mirror, run-quality
    // report. Composes with the other profiles (typically alongside AVITI24).
    internal { includeConfig 'conf/internal.config' }

    // 3' STAR_ALIGN stringency (does not affect variant STAR_ALIGN_VARIANT).
    star_default { params.star_mode = 'star_default' }
    star_relaxed { params.star_mode = 'relaxed' }
    star_diss_strict { params.star_mode = 'diss_strict' }
    star_diss_balanced { params.star_mode = 'diss_balanced' }
    star_diss_sensitive { params.star_mode = 'diss_sensitive' }
    star_diss_permissive { params.star_mode = 'diss_permissive' }
}

// ─────────────────────────────────────────────────────────────────────
// Backwards-compatibility for renamed params. Accept the old names and map
// them onto the current names, warning on each remap. Done in config (not
// main.nf) because Nextflow treats params as read-only in the workflow
// script; assigning params in config is the supported mechanism and runs
// before main.nf, the lazy conf/modules.config ext.args closures and the
// module container directives read them. Placed AFTER profiles{} so it also
// catches old names supplied via a profile, in addition to --flag CLI and
// -params-file. Old names are never declared in params{}, so containsKey(old)
// is true only when actually supplied.
// ─────────────────────────────────────────────────────────────────────
[
    spatialdata_container_url : 'spatialdata_build_container_url',   // renamed 1.12.0
    spatialdata_container_tag : 'spatialdata_build_container_tag',   // renamed 1.12.0
].each { oldName, newName ->
    if( params.containsKey(oldName) ) {
        System.err.println("WARNING: deprecated parameter '${oldName}' — use '${newName}'. Mapping '${oldName}' -> '${newName}'.")
        params[newName] = params[oldName]
    }
}

// Set default registry for Apptainer, Docker, Podman and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Singularity are enabled
apptainer.registry   = 'quay.io'
docker.registry      = 'quay.io'
podman.registry      = 'quay.io'
singularity.registry = 'quay.io'

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

// Load igenomes.config if required
includeConfig !params.igenomes_ignore ? 'conf/igenomes.config' : 'conf/igenomes_ignored.config'

